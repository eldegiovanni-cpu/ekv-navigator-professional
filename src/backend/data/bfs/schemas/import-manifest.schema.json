{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ekv-bfs-import-manifest-v1",
  "title": "EKV Navigator BFS Import Manifest",
  "type": "object",
  "required": ["schemaVersion", "releaseId", "entries"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "releaseId": { "type": "string", "minLength": 1 },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["dataset", "input"],
        "properties": {
          "dataset": { "enum": ["BUA", "NLI", "LSE_TA01", "LSE_T17", "LSE_TA11"] },
          "input": { "type": "string", "minLength": 1 },
          "sheet": { "type": "string" },
          "title": { "type": "string" }
        }
      }
    }
  }
}
