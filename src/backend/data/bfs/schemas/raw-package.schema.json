{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ekv-bfs-raw-package-v1",
  "title": "EKV Navigator BFS Raw Package",
  "type": "object",
  "required": [
    "schemaVersion",
    "dataset",
    "source",
    "rows"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "dataset": {
      "enum": [
        "BUA",
        "NLI",
        "LSE_TA01",
        "LSE_T17",
        "LSE_TA11"
      ]
    },
    "source": {
      "type": "object",
      "required": [
        "title",
        "publisher",
        "sourceFile"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "publisher": {
          "type": "string"
        },
        "publishedAt": {
          "type": "string"
        },
        "sourceFile": {
          "type": "string"
        },
        "sourceUrl": {
          "type": "string"
        },
        "sheetName": {
          "type": "string"
        },
        "profileId": {
          "type": "string"
        },
        "profileVersion": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    }
  }
}
